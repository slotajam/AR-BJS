# Copy to .env and fill in. Never commit .env.
# --- required in production ---
RIP_ENV=production
# generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
RIP_SECRET_KEY=change-me-to-64-random-characters
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=rip-minio
MINIO_ROOT_PASSWORD=change-me-too

# --- connectors (polite pools; strongly recommended) ---
RIP_CONTACT_EMAIL=you@your-institution.example
RIP_OPENALEX_ENABLED=true
RIP_OPENALEX_API_KEY=
RIP_CROSSREF_ENABLED=true
RIP_CROSSREF_PLUS_TOKEN=

# --- behaviour ---
RIP_ALLOW_REGISTRATION=true
RIP_ACCESS_TOKEN_MINUTES=60
RIP_PDF_MAX_BYTES=52428800
# hashing (offline, lexical proxy) or sentence-transformers (install the package + model first)
RIP_EMBEDDING_PROVIDER=hashing
# compose uses the pgvector image
RIP_PGVECTOR_ENABLED=true
RIP_CORS_ORIGINS=["http://localhost:8080"]
