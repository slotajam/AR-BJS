# Copy to .env and fill in. Never commit .env.
# --- required in production ---
RIP_ENV=production
# generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
RIP_SECRET_KEY=change-me-to-64-random-characters
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=rip-minio
MINIO_ROOT_PASSWORD=change-me-too

# --- public website (set by: ./rip.sh start --domain DOMAIN --email EMAIL) ---
# RIP_DOMAIN=research.example.org
# RIP_ACME_EMAIL=you@example.org            # Let's Encrypt expiry notices
# COMPOSE_FILE=docker-compose.yml:docker-compose.domain.yml
# Local port of the app (bound to 127.0.0.1 unless RIP_BIND is changed)
# RIP_PORT=8080

# --- connectors (polite pools; strongly recommended) ---
RIP_CONTACT_EMAIL=you@your-institution.example
RIP_OPENALEX_ENABLED=true
RIP_OPENALEX_API_KEY=
RIP_CROSSREF_ENABLED=true
RIP_CROSSREF_PLUS_TOKEN=

# --- behaviour ---
RIP_ALLOW_REGISTRATION=true
RIP_ACCESS_TOKEN_MINUTES=60
# failed sign-ins allowed per email per window (an IP gets 5x)
RIP_LOGIN_MAX_FAILURES=10
RIP_LOGIN_WINDOW_SECONDS=900
RIP_PDF_MAX_BYTES=52428800
# hashing (offline, lexical proxy) or sentence-transformers (install the package + model first)
RIP_EMBEDDING_PROVIDER=hashing
# compose uses the pgvector image
RIP_PGVECTOR_ENABLED=true
RIP_CORS_ORIGINS=["http://localhost:8080"]
